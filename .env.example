# Local demo only. Set false for Supabase.
DEMO_MODE=true
PORT=3001
CLIENT_ORIGIN=http://127.0.0.1:5173
DEMO_PASSWORD=knowledge-demo
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Required when DEMO_MODE=false. Use exactly this browser origin; no trailing slash.
# Production: https://YOUR_SERVICE.onrender.com (NODE_ENV=production on Render).
AUTH_ORIGIN=http://localhost:5173
# Optional; defaults to the AUTH_ORIGIN hostname. No scheme or port.
WEBAUTHN_RP_ID=
# Keep empty: production frontend and API must share the same origin.
VITE_API_URL=
# Self-service company email verification: SMTP2GO Free, verified sender, HTTPS API.
# Leave unconfigured to disable new registrations safely; existing passkeys still work.
MAIL_FROM=
SMTP2GO_API_KEY=
# Generate a random secret of at least 32 characters and keep it server-only.
EMAIL_CODE_SECRET=

# Microsoft Teams (Web redirect URI; not SPA)
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_REDIRECT_URI=http://localhost:3001/
# 32 random bytes as 64 hex chars; never commit the actual key
TEAMS_TOKEN_KEY=
