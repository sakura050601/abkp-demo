{
    "name": "design-knowledge-platform",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
        "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
        "dev:client": "vite --host 127.0.0.1",
        "build": "vite build",
        "start": "node --env-file-if-exists=.env server/index.js",
        "seed:demo": "node --env-file-if-exists=.env server/seed-demo.js",
        "test": "node --test tests/*.test.js"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.57.0",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-rate-limit": "^8.1.0",
        "helmet": "^8.1.0",
        "lucide-react": "^0.468.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "zod": "^4.1.0"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "^4.7.0",
        "concurrently": "^9.2.0",
        "vite": "^6.3.0"
    }
}