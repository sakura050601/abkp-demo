# Runtime configuration reference only. Do not add credentials to this file.
# Put secrets in ECS Secrets / Secrets Manager, not in the image or Git.
NODE_ENV=production
PORT=3001
DEMO_MODE=false
# Full fixed HTTPS origin, without trailing slash or path.
AUTH_ORIGIN=
# Optional: omit to use the AUTH_ORIGIN hostname. Never keep the old Render host.
# WEBAUTHN_RP_ID=
SUPABASE_URL=
# Secret reference: SUPABASE_SERVICE_ROLE_KEY
MAIL_FROM=
# Secret references: SMTP2GO_API_KEY, EMAIL_CODE_SECRET
